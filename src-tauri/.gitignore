# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Installer seed: the bundle is regenerated from a database export and can run
# to hundreds of megabytes, which has no business in git history. .gitkeep stays
# tracked so that `bundle.resources: ["seed/*"]` in tauri.conf.json always finds
# at least one file — an empty glob breaks the build — even on a fresh clone
# with no generated seed.
/seed/*.json
/seed/*.json.gz
